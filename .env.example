# N8N Workflow Configuration Placeholders

# Recipient email address for the daily digest
DIGEST_RECIPIENT_EMAIL=your-email@example.com

# Google Sheet Document ID (found in your Google Sheet URL)
# Example URL: https://docs.google.com/spreadsheets/d/<YOUR_GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID

# Target Google Sheet Tab Name (Default is Sheet1)
GOOGLE_SHEET_NAME=Sheet1
